FROM ghcr.io/graalvm/native-image-community:25 AS build
WORKDIR /workspace
COPY gradlew gradlew.bat settings.gradle.kts build.gradle.kts ./
COPY gradle gradle
COPY src src
RUN ./gradlew nativeCompile --no-daemon

FROM debian:12-slim AS runtime-libs
RUN apt-get update \
    && apt-get install --yes --no-install-recommends zlib1g \
    && rm -rf /var/lib/apt/lists/*

FROM gcr.io/distroless/base-debian12:nonroot
WORKDIR /app
COPY --from=runtime-libs /lib/x86_64-linux-gnu/libz.so.1* /lib/x86_64-linux-gnu/
COPY --from=build --chown=nonroot:nonroot /workspace/build/native/nativeCompile/devsquad-backend /app/devsquad
EXPOSE 8080
ENV LANG=C.UTF-8
ENTRYPOINT ["/app/devsquad"]
